# ExpertiseInPharma — Apache / cPanel settings

DirectoryIndex index.html

# Force HTTPS and the bare domain (https://expertiseinpharma.com)
# The site sits behind Cloudflare: the visitor's real protocol arrives in X-Forwarded-Proto / CF-Visitor,
# so only redirect when none of them say https (otherwise Cloudflare "Flexible" SSL would loop forever).
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://expertiseinpharma.com%{REQUEST_URI} [L,R=301]
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteCond %{HTTP:CF-Visitor} !https [NC]
RewriteRule ^ https://expertiseinpharma.com%{REQUEST_URI} [L,R=301]

# Old WordPress URLs -> new pages (keeps existing links and Google results working)
RewriteRule ^services/sme-on-demand/?$ /sme-on-demand [L,R=301]
RewriteRule ^services/resource-on-demand/?$ /resource-on-demand [L,R=301]
RewriteRule ^services/outsourced-ld-enablement/?$ /outsourced-ld [L,R=301]
RewriteRule ^services/global-capability-center-gcc-enablement/?$ / [L,R=301]
RewriteRule ^industry-solutions/pharmaceutical-companies/?$ /pharmaceutical-companies [L,R=301]
RewriteRule ^industry-solutions/clinical-research-organization/?$ /cro [L,R=301]
RewriteRule ^industry-solutions/?$ /industries [L,R=301]
RewriteRule ^outsourced-ld-enablement/?$ /outsourced-ld [L,R=301]
RewriteRule ^about-us/?$ /about [L,R=301]
RewriteRule ^contact-us/?$ /contact [L,R=301]
RewriteRule ^privacy-policy/?$ /privacy [L,R=301]
RewriteRule ^(mr-nitin-charekar|purav-thakkar)/?$ /about [L,R=301]
# WordPress sample posts, categories and form pages that should not stay indexed
RewriteRule ^(20[0-9]{2}/.*|category/.*|metform-form/.*)$ / [L,R=301]

# Clean URLs: /about serves about.html; /about.html, /about/ and /index.html redirect to the clean address
RewriteCond %{THE_REQUEST} \s/+index(\.html)?[\s?] [NC]
RewriteRule ^ / [L,R=301]
RewriteCond %{THE_REQUEST} \s/+([^?\s/]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [L,R=301]
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([^/.]+)/$ /$1 [L,R=301]
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([^/.]+)$ /$1.html [L]

# Keep working files off the public site
RewriteRule ^(partials|tools|form-backend)(/|$) - [F,L]
<FilesMatch "\.(md|py|gs)$">
  Require all denied
</FilesMatch>

ErrorDocument 404 /404.html
Options -Indexes

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml application/xml text/plain
</IfModule>

# Caching: pages revalidate, assets cache for 30 days
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType text/javascript "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
</IfModule>

# Basic security headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
